# AI Runtime Platform 环境变量样例
# 用法：cp .env.example .env，docker compose 会自动读取项目根目录的 .env。
# 容器内生效的变量以 docker-compose.yml 的 environment 为准，此处为覆盖入口。

# ── 平台核心 ────────────────────────────────────────────────────────────────
# LOG_LEVEL=INFO
# CELERY_TASK_ALWAYS_EAGER=0        # 1=进程内同步执行（仅测试用）
# REDIS_EVENT_FANOUT_ENABLED=1      # 多进程部署必须开启（SSE 跨进程 + steering 队列）
# MCP_SERVERS_JSON=                 # MCP 服务器声明 JSON（可选）

# ── 凭据（生产环境务必修改默认值）─────────────────────────────────────────
# POSTGRES_USER=agent
# POSTGRES_PASSWORD=agent
# POSTGRES_DB=agent_platform
# REDIS_PASSWORD=changeme           # 注意：修改后本地直连 redis 需用带密码的 URL
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_API_KEY=
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=

# ── API 加固 ────────────────────────────────────────────────────────────────
# CORS_ALLOW_ORIGINS=               # 逗号分隔白名单；空=仅同源（nginx 反代场景够用）
# MAX_REQUEST_BODY_MB=10
# RATE_LIMIT_ENABLED=1
# RATE_LIMIT_RPM=120                # 按 IP+方法滑动窗口；反代后需配 trusted proxy 解析真实 IP

# ── 并发容量 ────────────────────────────────────────────────────────────────
# API_WORKERS=2                     # uvicorn 进程数；SSE/steering 靠 Redis fanout 支持多进程
# DB_POOL_SIZE=10                   # 每进程常驻连接数（仅 Postgres 生效）
# DB_MAX_OVERFLOW=20                # 每进程峰值可借的额外连接数
# DB_POOL_RECYCLE=1800              # 连接最大存活秒数，防止被服务端静默断开

# ── 边缘网关（web 的 nginx，最外层入口）────────────────────────────────────
# BACKEND_UPSTREAM=http://api:8000  # /api 反代上游
# NGINX_API_RATE=30r/s              # per-IP 令牌速率；应用层 RATE_LIMIT_RPM 是精确限流，此处防滥用
# NGINX_API_BURST=60                # per-IP 突发容忍（不排队，超了直接 429）
# NGINX_MAX_BODY_SIZE=10m           # 须与 MAX_REQUEST_BODY_MB 一致

# ── Evaluation 巡检调度 ─────────────────────────────────────────────────────
# EVALUATION_PATROL_CRON=           # celery beat crontab，如 "0 3 * * *"；空=不调度
# EVALUATION_PATROL_ASSET=regression-set
# EVALUATION_PATROL_APPLICATION_ID= # 巡检查评 Run 的目标 application；未设置则任务跳过

# ── Sandbox Warm Pool（默认关闭）────────────────────────────────────────────
# 预热沙箱池，降低冷启动延迟（docs/specs/sandbox-warm-pool-spec.md）。
# SANDBOX_WARM_POOL_ENABLED=1
# SANDBOX_WARM_POOL_TEMPLATES_JSON=[{"name":"python-sbx","provider":"docker","image":"python:3.12-slim","target_size":4}]
# SANDBOX_WARM_POOL_MAX_TOTAL=32                # 全局池上限，约束空闲资源
# SANDBOX_WARM_POOL_MAX_IDLE_SECONDS=900        # 超龄预热沙箱驱逐（卫生轮换）
# SANDBOX_WARM_POOL_MAINTAIN_INTERVAL_SECONDS=30  # beat 维护周期（默认队列）
# SANDBOX_WARM_POOL_CLAIM_TIMEOUT_MS=1000       # claim 的 Redis 超时上限；失败即走冷创建
